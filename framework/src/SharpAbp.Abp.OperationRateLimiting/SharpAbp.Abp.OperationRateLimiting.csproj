<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../common.props" />
  <Import Project="../../../configureawait.props" />
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;$(NetCoreFx)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <AssemblyName>SharpAbp.Abp.OperationRateLimiting</AssemblyName>
    <PackageId>SharpAbp.Abp.OperationRateLimiting</PackageId>
    <RootNamespace />
    <Description>ABP operation count limiting with replaceable atomic storage</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Volo.Abp.Users.Abstractions" />
    <PackageReference Include="Volo.Abp.MultiTenancy.Abstractions" />
    <PackageReference Include="Volo.Abp.Caching" />
    <PackageReference Include="Volo.Abp.DistributedLocking.Abstractions" />
    <PackageReference Include="Volo.Abp.Timing" />
    <PackageReference Include="Volo.Abp.Localization" />
    <PackageReference Include="Volo.Abp.VirtualFileSystem" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="SharpAbp\Abp\OperationRateLimiting\Localization\Resources\*.json" />
    <EmbeddedResource Include="SharpAbp\Abp\OperationRateLimiting\Localization\Resources\*.json" />
  </ItemGroup>
</Project>
