<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\..\common.test.props" />
	<PropertyGroup>
		<TargetFramework>$(NetCoreFx)</TargetFramework>
		<IsPackable>false</IsPackable>
		<RootNamespace />
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Moq"  />
		<PackageReference Include="xunit"  />
		<PackageReference Include="xunit.runner.visualstudio" >
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<PackageReference Include="Volo.Abp.Autofac" />
		<PackageReference Include="Volo.Abp.TestBase" />
		<!-- Match the existing Oracle.Devart adapter's minimum relational patch. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="$(DevartEfCoreRelationalPackageVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\SharpAbp.Abp.DbConnections.DM\SharpAbp.Abp.DbConnections.DM.csproj" />
		<ProjectReference Include="..\..\src\SharpAbp.Abp.DbConnections.GaussDB\SharpAbp.Abp.DbConnections.GaussDB.csproj" />
		<ProjectReference Include="..\..\src\SharpAbp.Abp.DbConnections.Oracle.Devart\SharpAbp.Abp.DbConnections.Oracle.Devart.csproj" />
		<ProjectReference Include="..\..\src\SharpAbp.Abp.DbConnections.OceanBase\SharpAbp.Abp.DbConnections.OceanBase.csproj" />
		<ProjectReference Include="..\..\src\SharpAbp.Abp.DbConnections.MySQL\SharpAbp.Abp.DbConnections.MySQL.csproj" />
		<ProjectReference Include="..\..\src\SharpAbp.Abp.DbConnections.Oracle\SharpAbp.Abp.DbConnections.Oracle.csproj" />
		<ProjectReference Include="..\..\src\SharpAbp.Abp.DbConnections.PostgreSql\SharpAbp.Abp.DbConnections.PostgreSql.csproj" />
		<ProjectReference Include="..\..\src\SharpAbp.Abp.DbConnections.Sqlite\SharpAbp.Abp.DbConnections.Sqlite.csproj" />
		<ProjectReference Include="..\..\src\SharpAbp.Abp.DbConnections.SqlServer\SharpAbp.Abp.DbConnections.SqlServer.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
